<?xml version="1.0" encoding="utf-8"?>
<!--
  Consumer-side test for the NuGet package, driven by nuget/pack.ps1: a
  plain Visual Studio console project that imports the package's .targets
  exactly as NuGet would and compiles .github/package-test/main.cpp.
  It deliberately sets no include path, library or language standard;
  all of that must come from the package. Builds at /W4 with warnings as
  errors, so the public headers must stay warning-free.

  msbuild PackageConsumer.vcxproj -p:Platform=x64 -p:Configuration=Release
          -p:AsposePdfFossTargets=<extracted package>\build\native\Aspose.PDF.Cpp.FOSS.targets
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32"><Configuration>Debug</Configuration><Platform>Win32</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32"><Configuration>Release</Configuration><Platform>Win32</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64"><Configuration>Debug</Configuration><Platform>ARM64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64"><Configuration>Release</Configuration><Platform>ARM64</Platform></ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{6C1A8F52-3E0B-4D7A-9B51-2F4E8D1C7A30}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>PackageConsumer</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)' == 'Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)' != 'Debug'">false</UseDebugLibraries>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="..\..\.github\package-test\main.cpp" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <ImportGroup Label="ExtensionTargets">
    <Import Project="$(AsposePdfFossTargets)" Condition="Exists('$(AsposePdfFossTargets)')" />
  </ImportGroup>

  <Target Name="RequirePackageTargets" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(AsposePdfFossTargets)')"
           Text="Pass -p:AsposePdfFossTargets=&lt;path to Aspose.PDF.Cpp.FOSS.targets&gt;." />
  </Target>
</Project>
