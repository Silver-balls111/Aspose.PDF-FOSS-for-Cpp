@PACKAGE_INIT@

# Aspose.PDF FOSS for C++ — CMake package config.
#
#   find_package(aspose_pdf_foss CONFIG REQUIRED)
#   target_link_libraries(app PRIVATE aspose_pdf_foss::aspose_pdf_foss)
#
# The library is static and depends on nothing but the C++ standard
# library. The target carries a cxx_std_20 compile feature, so
# consumers are switched to C++20 automatically.

include("${CMAKE_CURRENT_LIST_DIR}/aspose_pdf_fossTargets.cmake")

check_required_components(aspose_pdf_foss)
